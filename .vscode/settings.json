{
  // Formatting matches `pnpm format`, so the editor and the `format` gate cannot
  // disagree and turn every save into a diff.
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "[svelte]": { "editor.defaultFormatter": "svelte.svelte-vscode" },
  // Shell goes through shfmt with the flags the house rule names (`shfmt -i 4 -ci`),
  // stated here as well as in .editorconfig because the extension passes its own flags
  // and shfmt only reads .editorconfig when given none.
  "[shellscript]": { "editor.defaultFormatter": "foxundermoon.shell-format" },
  "shellformat.flag": "-i 4 -ci",

  // The class strings in this codebase are long and conditional. Wrapping them makes
  // the ternaries readable instead of a horizontal scroll.
  "editor.wordWrap": "on",

  // Generated. Editing one is erased by the next build — AGENTS.md §2.2.
  "files.readonlyInclude": {
    "**/sdk/host/index.ts": true,
    "**/sdk/kit/index.ts": true,
    "**/sdk/icons.ts": true,
    "client/services/index.ts": true,
    "client/game/index.ts": true,
    "server/services/index.ts": true,
    "fxmanifest.lua": true,
    "dist/**": true
  },

  "search.exclude": { "dist": true, "playwright-report": true, "test-results": true },
  "typescript.tsdk": "node_modules/typescript/lib",

  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  }
}
