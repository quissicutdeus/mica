{
  "config": {
    "default": true,
    "MD013": {
      "line_length": 80,
      "code_blocks": false,
      "tables": false
    },
    "MD024": {
      "siblings_only": true
    }
  },
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    "**/dist/**",
    "web/docs/**",
    ".superpowers/**",
    ".claude/**",
    "CLAUDE.md"
  ]
}
