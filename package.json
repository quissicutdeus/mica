{
  "name": "gphone",
  "private": true,
  "version": "1.0.0",
  "description": "An open-source TypeScript phone for FiveM",
  "type": "module",
  "browserslist": [
    "chrome 103"
  ],
  "scripts": {
    "build": "node scripts/generate-barrels.js && pnpm typecheck && pnpm build:nocheck",
    "build:nocheck": "pnpm clearbuild && node scripts/generate-barrels.js && node build/build-bundle.js && pnpm build:web && node scripts/check-license-banner.js",
    "build:web": "pnpm --filter web build",
    "docs:sdk": "pnpm --filter web docs:sdk",
    "clearbuild": "node scripts/clear-build.js",
    "generate:sql": "node scripts/generate-sql.js",
    "generate:sql:reset": "node scripts/generate-sql.js --with-reset",
    "dev": "concurrently -c \"cyan,magenta\" -n \"fivem,vite\" \"pnpm watch\" \"pnpm watch:web\"",
    "typecheck:client": "tsc --noEmit -p client/tsconfig.json",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json",
    "typecheck:web": "pnpm --filter web check",
    "typecheck:sdk": "node scripts/check-sdk-partition.js && tsc --noEmit -p sdk/tsconfig.tsc.json && pnpm --filter @gphone/sdk check",
    "typecheck": "concurrently \"pnpm:typecheck:*\"",
    "watch": "pnpm clearbuild && node scripts/generate-barrels.js && cross-env IS_WATCH_MODE=1 node build/build-bundle.js",
    "watch:web": "pnpm --filter web dev",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "concurrently -c \"cyan,magenta\" -n \"web,server\" \"pnpm:test:unit:web\" \"pnpm:test:unit:server\"",
    "test:unit:web": "pnpm --filter web test:unit",
    "test:unit:server": "vitest run",
    "test:unit:changed": "concurrently -c \"cyan,magenta\" -n \"web,server\" \"pnpm:test:unit:web:changed\" \"pnpm:test:unit:server:changed\"",
    "test:unit:web:changed": "pnpm --filter web test:unit:changed",
    "test:unit:server:changed": "vitest run --changed",
    "test:watch:server": "vitest",
    "test:migrations": "node scripts/test-migrations.js",
    "test:e2e:install": "pnpm --filter web test:e2e:install",
    "test:e2e": "pnpm --filter web test:e2e",
    "test:e2e:headed": "pnpm --filter web test:e2e:headed",
    "test:e2e:report": "pnpm --filter web test:e2e:report",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache .",
    "deadcode": "pnpm dlx knip",
    "lint:container": "node scripts/lint-container.js",
    "lint:md": "markdownlint-cli2",
    "lint:agents": "node scripts/check-agents-size.js",
    "lint:actions": "node scripts/check-action-versions.js",
    "lint:ts": "oxlint .",
    "lint:css": "stylelint \"**/*.{css,svelte}\" --custom-syntax postcss-html",
    "lint:web": "pnpm --filter web lint",
    "lint:sdk": "pnpm --filter @gphone/sdk lint",
    "lint": "concurrently -c \"cyan,magenta,blue,green\" -n \"ts,web,sdk,css\" \"pnpm:lint:ts\" \"pnpm:lint:web\" \"pnpm:lint:sdk\" \"pnpm:lint:css\"",
    "demo": "docker compose up --build",
    "demo:up": "docker compose up -d --build",
    "demo:down": "docker compose down",
    "demo:smoke": "node scripts/smoke-image.js",
    "new:app": "node scripts/new-app.js",
    "verify": "node scripts/verify.js",
    "verify:quick": "node scripts/verify.js --quick",
    "check:fast": "node scripts/generate-barrels.js && pnpm format:check && pnpm typecheck && pnpm test:unit:changed",
    "dev:check": "node scripts/dev-check.js",
    "prepare": "node scripts/install-git-hooks.js"
  },
  "author": "quissicutdeus",
  "license": "AGPL-3.0-or-later",
  "repository": "https://github.com/quissicutdeus/gphone",
  "lint-staged": {
    "*.{ts,svelte,js,json,md,css}": "prettier --write"
  },
  "devDependencies": {
    "@citizenfx/client": "2.0.34410-1",
    "@citizenfx/server": "2.0.34410-1",
    "@gphone/shared": "workspace:*",
    "@types/node": "^26.2.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "lint-staged": "^17.3.0",
    "markdownlint-cli2": "^0.23.2",
    "mysql2": "^3.24.2",
    "oxlint": "^1.80.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "stylelint": "^17.14.1",
    "stylelint-no-unsupported-browser-features": "^8.1.1",
    "typescript": "^7.0.2",
    "typescript-ast-parser": "npm:typescript@~6.0.3",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}
