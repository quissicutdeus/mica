{
  "compilerOptions": {
    "target": "es2021",
    "incremental": true,
    "tsBuildInfoFile": "../node_modules/.tmp/client.tsbuildinfo",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "module": "CommonJS",
    "types": ["@citizenfx/client"],
    "lib": ["es2021"],
    "noUnusedLocals": true,
    "paths": {
      "@mica/shared/*": ["../shared/*"]
    }
  },
  "include": ["./**/*", "../shared/**/*"],
  "exclude": ["**/node_modules", "**/__tests__/*", "**/*.test.ts", "../shared/**/*.test.ts"]
}
