{
  "name": "ticket-key-branch-names",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~ALL"],
      "exclude": ["refs/heads/dependabot/**"]
    }
  },
  "rules": [
    {
      "type": "branch_name_pattern",
      "parameters": {
        "name": "Branch names must be a MICA ticket key",
        "operator": "regex",
        "pattern": "^(main|dev|MICA-[0-9]+(-[a-z0-9]+)*)$",
        "negate": false
      }
    }
  ]
}
