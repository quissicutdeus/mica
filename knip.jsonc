{
  // Dead-code scanning. Run with `pnpm deadcode`.
  //
  // Without this, knip reports eighteen "unused files" and four unused exports that are
  // all false positives, and a report you have to mentally filter is a report nobody
  // reads. The point of the config is that a hit means something.
  "$schema": "https://unpkg.com/knip@5/schema.json",
  // A type exported for a consumer to name, but referenced within its own file, is not
  // dead — `PushOptions` types `push()`'s parameter and `KeybindContext` types a field on
  // `KeybindAction`. Reporting those trains people to ignore the report, which is the one
  // thing this config exists to prevent.
  "ignoreExportsUsedInFile": true,
  // `@public` marks an export as SDK surface for add-ons rather than something this repo
  // is expected to consume. It is a narrow exemption on purpose: `sdk/index.ts` is
  // still not an entry point, so an exported *component* nobody renders is reported as
  // before. Only what someone has deliberately labelled public is exempt, and the label
  // sits next to the code rather than in this file.
  "tags": ["-public"],
  // `lint-staged` is invoked by .githooks/pre-commit, a shell script knip does not parse.
  // It was visible until the hooks stopped being generated from a `simple-git-hooks` block
  // in package.json, which knip did read. The dependency is genuinely used; nothing but the
  // evidence moved. Kept to this one name rather than ignoring the check, so a devDependency
  // that really does go unused is still reported.
  // `jsdom` is declared in `web/package.json`, which is correct: `web`'s vitest config is
  // what runs the file that names it. But that config also globs `../shared/**/*.test.ts`,
  // while this config lists `shared/**/*.ts` under the root workspace — so knip attributes
  // `shared/musicBroadcast.test.ts` to a project whose package.json has no `jsdom`, and
  // reports a dependency that is genuinely installed and genuinely used. The file needs the
  // environment for the reason its own docblock gives (MICA-176): its subject transitively
  // reaches `services/admin.ts`, which reads `window` at module scope.
  //
  // Named rather than switching the check off, matching `lint-staged` above: a devDependency
  // that really is unused still gets reported.
  "ignoreDependencies": ["lint-staged", "jsdom"],
  "workspaces": {
    ".": {
      // esbuild builds these two directly (`build/build-bundle.js`), so nothing in the
      // repo imports them and knip cannot infer that they are roots.
      "entry": ["client/client.ts", "server/server.ts", "scripts/*.js", "build/*.js"],
      "project": ["client/**/*.ts", "server/**/*.ts", "scripts/**/*.js", "build/**/*.js"]
    },
    // MICA-186: its own workspace now that `shared/` is a root-level package, for the
    // same reason `sdk` below is. `shared/**/*.ts` stayed listed under `.` for one run
    // after the promotion and knip reported it as "Refine project pattern (no matches)" --
    // a warning, not a failure, so `deadcode` stayed green while silently covering nothing
    // here. Every file is imported by client, server, web or sdk; there are no entry points
    // of its own, which is the point of the package.
    "shared": {
      "project": ["**/*.ts"]
    },
    "web": {
      "entry": ["e2e/**/*.spec.ts", "*.config.ts"],
      "project": ["src/**/*.{ts,svelte}"]
    },
    // MICA-172: its own workspace now that `sdk/` is a root-level package. Same entry
    // reasoning as when these lines lived under `web`:
    //
    // `icons.ts` is an entry point rather than ordinary code — generated, and deliberately
    // republishing every icon so an add-on can import any of them. Its exports being unused
    // inside this repo is the intended state.
    //
    // `index.ts` is deliberately NOT listed. Treating the whole SDK as public API would stop
    // knip ever reporting an unused export from it — and an exported, complete, unused
    // component is exactly what this found last time.
    //
    // `host/iframe/facets/*.ts` twins are reached only through the add-on build's alias
    // (`web/vite.addon.config.ts`), never by a static import in this repo.
    //
    // The `jsdom` wart noted in `ignoreDependencies` above now applies here too: this
    // package's suite runs under `web`'s Vitest project (its `include` globs `../sdk/**`),
    // so knip attributes SDK test files to a package.json that is not the one declaring the
    // test runner's environment. Extend that note rather than switching the check off.
    "sdk": {
      "entry": ["icons.ts", "addon.ts", "host/iframe/facets/*.ts"],
      "project": ["**/*.{ts,svelte}"]
    }
  }
}
