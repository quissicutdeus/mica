  "//": "MICA-172. Consumed as source: the phone and every add-on bundle build this package through their own Vite pipeline, so there is no build step and no `main`. `exports` names the three entry points an app may reach plus the design system; `@gphone/sdk/testing` is deliberately absent, because it resolves to `web/src/testing.ts` — a phone helper, not published contract (see `publicSurface.test.ts`). It stays an alias on the web side.",
  "exports": {
    ".": "./index.ts",
    "./app": "./app.ts",
    "./core": "./core.ts",
    "./app.css": "./app.css",
    "./app-utilities.css": "./app-utilities.css",
    "./app-reset.css": "./app-reset.css"
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
