{
  "compilerOptions": {
    // MICA-112, MICA-199: this pair (target/lib here, esbuild's `target` in
    // build/build-bundle.js) must agree with FXServer's actual server-side Node
    // version. Node 22 is opted in via `node_version '22'` in fxmanifest.lua (see
    // scripts/generate-barrels.js). Node 22's V8 supports ES2023 (toSorted,
    // toReversed, toSpliced, with, Array.prototype.findLast, Object.groupBy).
    "target": "es2023",
    "incremental": true,
    "tsBuildInfoFile": "../node_modules/.tmp/server.tsbuildinfo",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "module": "CommonJS",
    "types": ["@citizenfx/server"],
    "lib": ["es2023"],
    "noUnusedLocals": true,
    "paths": {
      "@gos/shared/*": ["../shared/*"]
    }
  },
  "include": ["./**/*", "../shared/**/*"],
  "exclude": ["**/node_modules", "**/__tests__/*", "**/*.test.ts", "../shared/**/*.test.ts"]
}
