{
  "compilerOptions": {
    "target": "es2021",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "module": "CommonJS",
    "types": ["@citizenfx/server"],
    "lib": ["es2021"],
    "paths": {
      "@shared/*": ["../shared/*"]
    }
  },
  "include": ["./**/*", "../shared/**/*"],
  "exclude": ["**/node_modules", "**/__tests__/*"]
}
