{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2021",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "typeRoots": ["./node_modules/@types", "../node_modules/@types"],
    "types": ["node", "svelte", "vite/client"],
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    // Unused imports and locals are errors, in `.ts` and in `.svelte` alike —
    // `svelte-check` surfaces them through the same compiler pass. This is what replaced
    // `scripts/clean-imports.js`, which tried to answer the same question with a regex
    // over the file text and could only ever approximate it. Turning this on found 45
    // dead declarations the script had been walking past, two of which were live bugs
    // rather than litter.
    //
    // `noUnusedParameters` is deliberately *not* set: Svelte event handlers and store
    // callbacks routinely take an argument they do not read, and prefixing every one with
    // `_` to satisfy the compiler is noise rather than cleanliness.
    "noUnusedLocals": true,
    "moduleDetection": "force",
    // `@gphone/sdk` here always resolves to `index.ts`, even for the source of a `core: false`
    // add-on — only `vite.addon.config.ts` redirects the bare specifier to the smaller
    // `addon.ts` for a real add-on bundle. A single `tsconfig` cannot fork that resolution
    // per source directory (paths are project-wide), and a second project scoped to just
    // `core: false` app directories would need its own dynamically generated `include` list
    // mirroring `vite.addon.config.ts`'s `addOnIds()` — a second piece of config that drifts
    // from the first exactly the way this ticket (MICA-129) was filed to close. So this
    // divergence is accepted rather than papered over here: `sdk/publicSurface.test.ts`'s
    // parity arm reads `index.ts` and `addon.ts` directly (source and runtime) and fails on
    // any undeclared difference, which is what actually catches "typechecks clean, breaks at
    // `vite build`" without a second resolution graph to keep in sync.
    "paths": {
      "@shared/*": ["../shared/*"],
      // MICA-172: explicit, and it must stay ahead of the `@gphone/sdk/*` wildcard below.
      // `testing.ts` moved to `src/testing.ts` when the in-process facets left the SDK — it
      // renders an app the way the shell does, so it is a phone helper, not a package export.
      // The specifier is unchanged; only what backs it moved.
      "@gphone/sdk/testing": ["./src/testing.ts"],
      "@gphone/sdk": ["./src/sdk/index.ts"],
      "@gphone/sdk/*": ["./src/sdk/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.js", "src/**/*.svelte"]
}
