{
  "name": "web",
  "private": true,
  "version": "1.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "concurrently -c \"green,yellow\" -n \"shell,addons\" \"vite\" \"node scripts/build-addons.mjs --watch\"",
    "build": "node scripts/build-addons.mjs && vite build",
    "build:addons": "node scripts/build-addons.mjs",
    "build:e2e": "node scripts/build-addons.mjs && cross-env NODE_ENV=development vite build --mode development",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings && tsc -p tsconfig.node.json",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:changed": "vitest run --changed",
    "test:watch": "vitest",
    "test:e2e:install": "playwright install",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed --workers=1",
    "test:e2e:report": "playwright show-report playwright-report",
    "docs:sdk": "node scripts/docs-sdk.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.6",
    "autoprefixer": "^10.6.2",
    "axe-core": "^4.14.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "postcss-preset-env": "^11.6.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@material/material-color-utilities": "0.4.0",
    "@mica/sdk": "workspace:*",
    "@mica/shared": "workspace:*"
  }
}
