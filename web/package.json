    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.1.1",
    "autoprefixer": "^10.5.4",
    "jsdom": "^29.1.1",
    "marked": "^18.0.7",
    "postcss": "^8.5.23",
    "postcss-preset-env": "^11.3.2",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.3",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
